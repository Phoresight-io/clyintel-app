# ClyIntel — local development environment (.env.local)
#
# Copy to `.env.local` and fill in real values. `.env.local` is git-ignored.
#
# ⚠️ LOCAL DEV POINTS AT THE **TEST** SUPABASE DB (clyintel-dev /
#    mhvuqjryesjsrictesuk) — NEVER at Prod (ftttyxknwwrlfsqxntxr). Local runs and
#    tests must not touch the production database.
# ⚠️ Use Stripe TEST keys locally (sk_test_...). The live-charge gate stays closed
#    off Vercel production, but never put an sk_live key in a local/preview env.
# ⚠️ Do NOT set VERCEL_ENV or VERCEL_URL locally — Vercel injects them in the
#    cloud. Forcing VERCEL_ENV=production locally is dangerous (it is one half of
#    the real-charge gate).
#
# Every NAME below must also exist (with env-appropriate values) in BOTH Vercel
# projects — Test (on `develop`) and Prod (on `main`). Same names, different
# values; that parity is the env contract this app validates at runtime.

# ── REQUIRED — Supabase ──────────────────────────────────────────────────────
# Public (safe to expose to the browser). Point at the TEST project.
NEXT_PUBLIC_SUPABASE_URL=https://mhvuqjryesjsrictesuk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<test-project-anon-publishable-key>
# Server-only. Service-role key — privileged writes / audit_log. NEVER expose
# client-side. Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<test-project-service-role-key>

# ── REQUIRED — Stripe (use TEST keys locally) ────────────────────────────────
STRIPE_SECRET_KEY=sk_test_<your-test-key>
# Signing secret for the Stripe webhook route (whsec_...). Required to accept
# webhook deliveries locally (Stripe CLI `stripe listen` prints one).
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-signing-secret>

# ── REQUIRED — Anthropic (AI agents) ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-<your-key>

# ── REQUIRED — MailerSend (email) ────────────────────────────────────────────
APP_MAILERSEND_API_KEY=<mailersend-api-token>
# Signing secret for the inbound MailerSend webhook route.
MAILERSEND_WEBHOOK_SECRET=<mailersend-webhook-secret>

# ── REQUIRED — At-rest secret encryption (QBO tokens) ────────────────────────
# 32 raw bytes, base64-encoded. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=<base64-32-byte-key>

# ── QuickBooks Online (Intuit) — required to use the QBO integration ─────────
# Use the SANDBOX base + sandbox app credentials locally.
QBO_CLIENT_ID=<intuit-app-client-id>
QBO_CLIENT_SECRET=<intuit-app-client-secret>
QBO_BASE_URL=https://sandbox-quickbooks.api.intuit.com
QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=<intuit-webhook-verifier-token>

# ── Voice (Vapi) — required to place/receive demo calls ──────────────────────
VAPI_API_KEY=<vapi-api-key>
VAPI_PHONE_NUMBER_ID=<vapi-phone-number-id>
VAPI_ASSISTANT_ID=<vapi-production-assistant-id>
VAPI_ASSISTANT_ID_TEST=<vapi-test-assistant-id>
VAPI_WEBHOOK_SECRET=<vapi-webhook-shared-secret>

# ── Cron / ops bearer secrets (fail closed if unset) ─────────────────────────
# Each guards a scheduled/ops endpoint via an Authorization: Bearer <secret>.
SETTLEMENT_CRON_SECRET=<random-secret>
SETTLEMENT_REFUNDS_OPS_SECRET=<random-secret>
OUTREACH_RUN_SECRET=<random-secret>
OUTREACH_CRON_SECRET=<random-secret>
QBO_WORKER_CRON_SECRET=<random-secret>

# ── Outreach cron config (optional behavior fences; default = dry run) ────────
# OUTREACH_CRON_MODE=live            # anything but "live" ⇒ dry_run (default)
# OUTREACH_CRON_SUBSCRIBER_ID=<uuid> # REQUIRED when mode=live (fences the run)
# OUTREACH_CRON_INVOICE_ID=<uuid>    # optional single-invoice fence

# ── Optional — public site / Google Drive import ─────────────────────────────
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_GOOGLE_API_KEY=<google-picker-api-key>
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<google-oauth-client-id>
